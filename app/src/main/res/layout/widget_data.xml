<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_frame"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:letterSpacing="0.1"
        android:text="@string/widget_label"
        android:textAllCaps="true"
        android:textColor="@color/widget_fg"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="@string/dash"
        android:textColor="@color/widget_fg"
        android:textSize="30sp" />

    <ProgressBar
        android:id="@+id/widget_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"
        android:max="100"
        android:progressTint="@color/widget_fg"
        android:progressBackgroundTint="@color/widget_fg" />

    <TextView
        android:id="@+id/widget_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:maxLines="2"
        android:text="@string/widget_empty"
        android:textColor="@color/widget_fg"
        android:textSize="11sp" />
</LinearLayout>
